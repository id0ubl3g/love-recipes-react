# Copy to .env.local and fill in with your Supabase project data
# (Project Settings → API Keys). The publishable key is safe in the frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Shows "Continuar com Google" on the login screen. Turn it on only after
# configuring the Google provider in Supabase (SUPABASE_SETUP.md, step 5).
VITE_ENABLE_GOOGLE_LOGIN=false
